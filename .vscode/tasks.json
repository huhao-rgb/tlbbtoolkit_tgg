{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dart: 格式检查（不改文件）",
      "type": "shell",
      "command": "fvm dart format --output=none --set-exit-if-changed lib test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "group": "test"
    },
    {
      "label": "Dart: 格式化写回",
      "type": "shell",
      "command": "fvm dart format lib test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      // 免费个人团队的 "Mac Team Provisioning Profile" 只有 7 天有效期，
      // 过期后 flutter run 会报 "No profiles for ... were found"（Flutter 调
      // xcodebuild 时不传 -allowProvisioningUpdates）。该任务在启动前刷新它。
      "label": "macOS: 刷新开发签名 profile",
      "type": "shell",
      "command": "./scripts/macos-signing-refresh.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
