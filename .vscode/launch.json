{
  // F5 调试配置：云同步地址通过 `--dart-define` 编译期注入。
  //
  // ⚠️ `--dart-define` 必须放 **toolArgs**（传给 flutter 工具），
  //    放 `args` 会被当成传给 main() 的参数、define 不生效。
  //
  // 云同步地址与后端部署说明见 server/cloudbase/README.md。
  // 数据目录默认复用 SYNC_BASE_URL（同一 CloudBase 环境），无需重复配置。
  //
  // ⚠️ macOS 启动前会先跑 `preLaunchTask`：免费个人团队的开发 profile 只有 7 天
  //    有效期，过期时 flutter run 会报 "No profiles for ... were found"
  //    （Flutter 调 xcodebuild 不传 -allowProvisioningUpdates）。该任务负责刷新，
  //    本地 profile 有效时约 0.1s 直接跳过。详见 docs/macos-signing.md。
  "version": "0.2.0",
  "configurations": [
    {
      "name": "天工阁 · macOS（云同步）",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "macos",
      "preLaunchTask": "macOS: 刷新开发签名 profile",
      "toolArgs": [
        "--dart-define=SYNC_BASE_URL=https://tgg-account-d8gd8q1mc16b81044.service.tcloudbase.com"
      ]
    },
    {
      "name": "天工阁 · Chrome（云同步）",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define=SYNC_BASE_URL=https://tgg-account-d8gd8q1mc16b81044.service.tcloudbase.com"
      ]
    },
    {
      // 对照配置：不注入 SYNC_BASE_URL，用于验证「未配置云同步」的降级表现
      // （页头不显示同步徽标、同步弹窗默认落在「一次性同步码」）。
      "name": "天工阁 · macOS（仅本地）",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "macos",
      "preLaunchTask": "macOS: 刷新开发签名 profile"
    }
  ]
}
